# Server
PORT=8080
CORS_ORIGINS=http://localhost:3000,chrome-extension://__EXTENSION_ID__

# --- Risk signal sources ---

# The Graph Token API — wallet age + activity (Transfers endpoint). Get a key at
# https://thegraph-market.pinax.network/ (Pinax operates the Token API for The Graph — verified
# 2026-09-09, thegraph.com's own quick-start page redirects there).
GRAPH_TOKEN_API_KEY=
GRAPH_TOKEN_API_BASE_URL=https://api.pinax.network
# Confirmed supported networks: mainnet, base, arbitrum-one, solana. This is the chain where
# insured wallets have real history — NOT Arc, which the Token API doesn't index (unrelated to
# PolicyVault, which lives on Arc regardless). Change per-deployment if your users are Base-native.
GRAPH_TOKEN_API_NETWORK=mainnet

# subgraph/ — indexes Approval events from a curated set of major ERC-20 contracts on mainnet,
# as a second, faster-than-GoldRush signal for the same "unlimited approval" risk factor. Deploy
# via `graph deploy` from subgraph/, then paste the hosted query URL here. See subgraph/README.md.
GRAPH_SUBGRAPH_URL=

# GoldRush (Covalent) — token approvals endpoint (unlimited/stale allowance detection)
# https://goldrush.dev/docs/api-reference/foundational-api/security/get-token-approvals-for-address
GOLDRUSH_API_KEY=
GOLDRUSH_CHAIN_NAME=eth-mainnet

# ScamSniffer scam-database — free, no key, refreshed daily (7-day delay on open data)
# https://github.com/scamsniffer/scam-database
SCAMSNIFFER_ADDRESS_LIST_URL=https://raw.githubusercontent.com/scamsniffer/scam-database/main/blacklist/address.json

# Sourcify — free, no key, contract verification lookup
SOURCIFY_BASE_URL=https://sourcify.dev/server

# --- Arc chain / PolicyVault ---
# Verified live 2026-09-09 via `cast chain-id` / `cast call` — see contracts/README.md
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# USDC is a predeploy on Arc (also the native gas token) — fixed address, not something you deploy
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# From `forge script script/Deploy.s.sol` output — see contracts/README.md
POLICY_VAULT_ADDRESS=

# Claims agent's own wallet — the only key authorized to call payClaim() on PolicyVault
CLAIMS_AGENT_PRIVATE_KEY=

# --- Optional / stretch ---
# Hedera HCS audit log — leave blank to skip; claimsAgent no-ops if unset
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_HCS_TOPIC_ID=
