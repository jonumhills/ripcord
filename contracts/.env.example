# Deployer key for Arc testnet — never commit the real value
PRIVATE_KEY=

# Arc testnet — verified live 2026-09-09 via `cast chain-id` / `cast call`, see contracts/README.md
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# USDC is a predeploy on Arc (also the native gas token) — this address is fixed network-wide,
# not something you deploy yourself. 6 decimals via the ERC-20 interface.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Address of the backend's claims-agent wallet — only this address can call payClaim()
CLAIMS_AGENT_ADDRESS=

# Get testnet USDC (needed for BOTH gas and premiums, since USDC is Arc's native gas token):
# https://faucet.circle.com — select "Arc Testnet"
